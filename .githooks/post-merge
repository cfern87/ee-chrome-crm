#!/usr/bin/env bash
# Rebuild the extension after a pull.
#
# WHY: packages/extension/dist/ is gitignored, so `git pull` updates the source
# but leaves Chrome loading the previous build. Reloading the extension re-reads
# that same stale dist, which looks exactly like "the new feature didn't come
# across". This hook closes that gap automatically.
#
# Requires `git config core.hooksPath .githooks` — `npm install` does that via
# the root "prepare" script.

root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 0

# Nothing to rebuild if the extension source didn't change in this merge.
if ! git diff --name-only ORIG_HEAD HEAD 2>/dev/null | grep -qE '^packages/(extension|shared)/'; then
  exit 0
fi

if [ ! -d "$root/node_modules" ]; then
  echo ""
  echo "  ! Extension source changed but node_modules is missing."
  echo "  ! Run: npm install && npm run build   (then reload at chrome://extensions)"
  echo ""
  exit 0
fi

echo ""
echo "  Extension source changed — rebuilding packages/extension/dist ..."
if npm run build --workspace packages/extension --silent; then
  echo "  ✔ Rebuilt. Reload the extension at chrome://extensions to pick it up."
else
  echo ""
  echo "  ! BUILD FAILED — Chrome is still running the OLD build."
  echo "  ! Fix the error above, then: npm run build"
fi
echo ""

exit 0
